# =====================================================================
# Variáveis de ambiente raiz (usadas pelo docker-compose.dev.yml)
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env real.
# =====================================================================

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development

# Connection string para o Postgres do Supabase (homologação na VPS).
# Substitua HOST, PORT e POSTGRES_PASSWORD pelos valores reais da sua VPS Hostinger.
ConnectionStrings__Postgres=Host=<HOSTINGER_VPS_HOST>;Port=<PORT>;Database=postgres;Username=postgres;Password=<POSTGRES_PASSWORD>;SslMode=Require;Trust Server Certificate=true

# Origens permitidas para CORS (separadas por vírgula)
Cors__AllowedOrigins=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:5080/api

# --- Opcionais (Supabase Auth/Storage via REST — uso futuro) ---
# Supabase__Url=http://<HOSTINGER_VPS_HOST>:<KONG_PORT>
# Supabase__AnonKey=
# Supabase__ServiceRoleKey=
# Supabase__JwtSecret=
