# =====================================================================
# Variáveis de ambiente do backend (dev local conectando ao Supabase homolog da VPS)
# Copie este arquivo para .env e preencha os valores. NUNCA commite o .env real.
# =====================================================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5080

# Connection string para o Postgres do Supabase na VPS Hostinger.
# Substitua HOSTINGER_VPS_HOST, PORT e POSTGRES_PASSWORD.
ConnectionStrings__Postgres=Host=<HOSTINGER_VPS_HOST>;Port=<PORT>;Database=postgres;Username=postgres;Password=<POSTGRES_PASSWORD>;SslMode=Require;Trust Server Certificate=true

# CORS — origens permitidas, separadas por vírgula
Cors__AllowedOrigins=http://localhost:5173

# --- Logs Internos do Ambiente (Docker) ---
# Containers monitorados na página "Logs Internos do Ambiente".
# Formato CSV: "Alias=prefixo_do_servico". O prefixo casa com o nome do
# container no Swarm (stack_service.replica.taskid) pelo trecho antes do ponto.
MONITORED_CONTAINERS=Evolution=n8n_evolution-api,n8n=n8n_n8n,Postgres Evolution=n8n_evolution-api-db,Postgres n8n=n8n_n8n-postgres
# Caminho do socket do Docker (default já é este). Em produção, monte-o read-only
# no container do backend: /var/run/docker.sock:/var/run/docker.sock:ro
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Opcionais (Supabase Auth/Storage REST — uso futuro) ---
# Supabase__Url=http://<HOSTINGER_VPS_HOST>:<KONG_PORT>
# Supabase__AnonKey=
# Supabase__ServiceRoleKey=
# Supabase__JwtSecret=
